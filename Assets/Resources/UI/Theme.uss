/* Contrast for every piece of text in a themed panel (UiTheme.Apply): a dark shadow, and
   over the open sea a dark outline as well, so white and peach read over bright water. */

.theme-root .unity-text-element {
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

.theme-sea .unity-text-element {
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(12, 8, 20, 0.92);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.9);
}

/* Paper (UiTheme.Paper): navy ink on the sand gradient. Clean edges, no glow: a shadow or an
   outline would only blur dark type on a light ground. Declared last so it wins. The ink is
   inherited (not set on the text itself), so each screen's own colours still apply. */
.theme-paper {
    color: rgb(22, 36, 64);
}

.theme-paper .unity-text-element {
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    -unity-text-outline-width: 0;
}
