/* Story mode: the dialogue scenes and the chapter / mission screen. */

/* ------------------------------------------------------------ dialogue */

.dlg-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-end;
    align-items: center;
    background-color: rgba(4, 10, 16, 0.35);
}

.dlg-top {
    position: absolute;
    top: 28px;
    left: 40px;
    right: 40px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.dlg-title {
    font-size: 18px;
    color: rgb(255, 199, 69);
    -unity-font-style: bold;
    letter-spacing: 3px;
    background-color: rgba(8, 18, 28, 0.85);
    border-radius: 6px;
    padding: 6px 14px;
}

.dlg-skip {
    font-size: 18px;
    color: rgb(242, 247, 250);
    background-color: rgba(28, 52, 74, 0.9);
    border-width: 0;
    border-radius: 6px;
    padding: 8px 16px;
}

.dlg-skip:hover {
    background-color: rgb(46, 84, 116);
}

.dlg-box {
    flex-direction: row;
    width: 72%;
    max-width: 1200px;
    min-height: 230px;
    margin-bottom: 44px;
    padding: 18px;
    background-color: rgb(8, 18, 28);
    border-width: 2px;
    border-color: rgb(255, 199, 69);
    border-radius: 16px;
}

.dlg-portrait {
    width: 200px;
    height: 200px;
    flex-shrink: 0;
    border-width: 3px;
    border-color: rgb(255, 199, 69);
    border-radius: 12px;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(20, 30, 40);
}

.dlg-body {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 22px;
}

.dlg-name {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 199, 69);
    margin: 0;
}

.dlg-role {
    font-size: 16px;
    color: rgb(170, 186, 200);
    margin: 0 0 10px 0;
}

.dlg-text {
    font-size: 28px;
    color: rgb(242, 247, 250);
    white-space: normal;
    flex-grow: 1;
    margin: 0;
}

.dlg-hint {
    font-size: 16px;
    color: rgb(170, 186, 200);
    -unity-text-align: middle-right;
    margin: 6px 0 0 0;
}

/* ------------------------------------------------------------ story screen (title menu) */

/* The board: dark glass with a brass rim, like the title. */
.story-panel {
    position: absolute;
    left: 56px;
    top: 0;
    bottom: 0;
    width: 860px;
    padding: 28px 36px;
    justify-content: center;
    background-color: rgba(6, 14, 22, 0.95);
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: rgb(140, 110, 56);
}

.story-eyebrow {
    font-size: 15px;
    color: rgb(255, 199, 69);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin: 0;
}

.story-title {
    font-size: 34px;
    color: rgb(242, 247, 250);
    -unity-font-style: bold;
    margin: 2px 0 14px 0;
    white-space: normal;
}

/* Chapter tabs: brass plates; the open chapter is the chart's own paper. */
.story-tabs {
    flex-direction: row;
}

.story-tab {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    align-items: center;
    background-color: rgba(18, 34, 48, 0.95);
    border-width: 2px;
    border-bottom-width: 0;
    border-color: rgba(140, 110, 56, 0.7);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    padding: 8px 6px;
    margin: 0 3px;
}

.story-tab:hover {
    background-color: rgb(30, 54, 74);
}

.story-tab.selected {
    background-color: rgb(222, 204, 163);
    border-color: rgb(140, 110, 56);
}

.story-tab:disabled {
    opacity: 0.45;
}

.story-tab__number {
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgb(205, 165, 90);
    margin: 0;
}

.story-tab__name {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(242, 247, 250);
    margin: 0;
}

.story-tab.selected .story-tab__number {
    color: rgb(120, 82, 34);
}

.story-tab.selected .story-tab__name {
    color: rgb(64, 43, 23);
}

/* The chapter as an old sea chart. */
.chart-card {
    height: 330px;
    background-color: rgb(222, 204, 163);
    border-width: 2px;
    border-color: rgb(140, 110, 56);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    overflow: hidden;
}

.chart-fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.chart-rose {
    position: absolute;
    right: 18px;
    top: 34px;
}

.chart-text {
    position: absolute;
    left: 20px;
    top: 38px;
    width: 64%;
}

.chart-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(64, 43, 23);
    margin: 0;
    white-space: normal;
}

.chart-blurb {
    font-size: 15px;
    color: rgb(80, 58, 34);
    white-space: normal;
    margin: 4px 0 0 0;
}

.chart-focus {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(30, 92, 84);
    white-space: normal;
    margin: 6px 0 0 0;
}

.chart-portrait {
    position: absolute;
    right: 104px;
    top: 34px;
    width: 78px;
    height: 78px;
    border-width: 2px;
    border-color: rgb(110, 80, 40);
    border-radius: 39px;
    -unity-background-scale-mode: scale-and-crop;
}

/* A mission on the route: a round ink-rimmed marker with its number. */
.chart-marker {
    position: absolute;
    width: 54px;
    height: 54px;
    translate: -50% -50%;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(64, 43, 23);
    background-color: rgb(240, 228, 198);
    border-width: 3px;
    border-color: rgb(64, 43, 23);
    border-radius: 27px;
    padding: 0;
    margin: 0;
    transition-duration: 0.12s;
}

.chart-marker:hover {
    scale: 1.1 1.1;
}

.chart-marker.done {
    background-color: rgb(46, 110, 80);
    border-color: rgb(28, 70, 50);
    color: rgb(240, 248, 240);
}

.chart-marker.next {
    background-color: rgb(255, 199, 69);
    border-color: rgb(130, 82, 18);
}

.chart-marker.locked {
    opacity: 0.45;
}

.chart-marker.selected {
    border-width: 5px;
    border-color: rgb(165, 40, 28);
}

.chart-marker-caption {
    position: absolute;
    width: 170px;
    translate: -50% 34px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    color: rgb(64, 43, 23);
    white-space: normal;
    margin: 0;
}

/* The chosen mission: details and the SET SAIL plate. */
.mission-detail {
    margin-top: 12px;
    padding: 14px 16px;
    background-color: rgba(18, 34, 48, 0.95);
    border-width: 2px;
    border-color: rgba(140, 110, 56, 0.8);
    border-radius: 10px;
}

.mission-head {
    flex-direction: row;
    align-items: center;
}

.mission-number {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 199, 69);
    width: 70px;
    -unity-text-align: middle-center;
    margin: 0;
}

.mission-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 8px;
}

.mission-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(242, 247, 250);
    margin: 0;
}

.mission-summary {
    font-size: 16px;
    color: rgb(196, 209, 221);
    white-space: normal;
    margin: 2px 0 0 0;
}

.mission-tags {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 10px 0 0 78px;
}

.mission-tag {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(220, 228, 236);
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 3px 8px;
    margin: 0 6px 6px 0;
}

.mission-tag--weather {
    color: rgb(190, 220, 255);
    background-color: rgba(80, 130, 200, 0.3);
}

.mission-tag--danger {
    color: rgb(255, 200, 190);
    background-color: rgba(200, 50, 40, 0.35);
}

.mission-tag--pay {
    color: rgb(255, 199, 69);
}

.mission-tag--done {
    color: rgb(20, 40, 24);
    background-color: rgb(96, 200, 120);
}

.mission-words {
    font-size: 16px;
    color: rgb(120, 210, 190);
    white-space: normal;
    margin: 2px 0 0 78px;
}

.mission-sail {
    align-self: flex-end;
    margin-top: 10px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(28, 20, 6);
    background-color: rgb(205, 160, 72);
    border-width: 2px;
    border-color: rgb(255, 214, 120);
    border-radius: 10px;
    padding: 10px 34px;
}

.mission-sail:hover {
    background-color: rgb(228, 184, 92);
}

.mission-sail:disabled {
    opacity: 0.4;
}

.story-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 14px;
}

.story-progress {
    font-size: 16px;
    color: rgb(196, 209, 221);
}

.story-back {
    width: 200px;
    font-size: 20px;
    color: rgb(242, 247, 250);
    background-color: rgba(18, 34, 48, 0.95);
    border-width: 2px;
    border-color: rgba(140, 110, 56, 0.8);
    border-radius: 8px;
    padding: 10px;
    margin: 0;
}

.story-back:hover {
    background-color: rgb(30, 54, 74);
}

/* ------------------------------------------------------------ shipyard mission card */

.story-brief {
    padding: 12px 14px;
    margin: 4px 0 10px 0;
    background-color: rgba(255, 199, 69, 0.08);
    border-width: 1px;
    border-color: rgba(255, 199, 69, 0.5);
    border-radius: 10px;
}

.story-brief-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(242, 247, 250);
    margin: 0;
    white-space: normal;
}

.story-brief-text {
    font-size: 16px;
    color: rgb(196, 209, 221);
    white-space: normal;
    margin: 4px 0 0 0;
}

.story-brief-words {
    font-size: 17px;
    color: rgb(120, 210, 190);
    white-space: normal;
    margin: 8px 0 0 0;
}

.story-brief-replay {
    font-size: 15px;
    margin: 8px 0 0 0;
    padding: 6px 10px;
    align-self: flex-start;
}

.story-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 8px 0 0 0;
}

.story-chip {
    font-size: 16px;
    color: rgb(120, 210, 190);
    background-color: rgba(120, 210, 190, 0.12);
    border-width: 1px;
    border-color: rgba(120, 210, 190, 0.5);
    border-radius: 12px;
    padding: 3px 10px;
    margin: 0 6px 6px 0;
}

.story-chip.done {
    color: rgb(20, 40, 24);
    background-color: rgb(96, 200, 120);
    border-color: rgb(96, 200, 120);
}
