/* The shipyard and the voyage report, in the game's Alto-style look (UiTheme).
   The store is on paper (UiTheme.Paper): navy ink on a sand gradient from the left edge,
   projector-safe, bold words, nothing under 16px. One page, few choices: the job (or the
   story mission and its phrases), then SET SAIL. Upgrades are one link away.
   The report stays white on a dusk dim, like the rest of the game at sea.
   Sizes are 1080p pixels (the panel scales). */

.shipyard-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.store-panel {
    position: absolute;
    left: 100px;
    top: 56px;
    bottom: 44px;
    width: 600px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

/* Nothing in the store squashes when content grows; the spacer above SET SAIL absorbs it. */
.store-panel > * {
    flex-shrink: 0;
}

.store-panel > .spacer {
    flex-shrink: 1;
}

/* The heading and the money: one line. */
.store-head {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-color: rgba(22, 36, 64, 0.3);
}

.store-title {
    flex-shrink: 1;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(22, 36, 64);
    white-space: normal;
    margin: 0;
}

.credits-value {
    flex-shrink: 0;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(12, 108, 98);
    margin: 0 0 0 20px;
}

/* What the radio heard, and other news: room is kept for it, so nothing jumps. */
.toast {
    min-height: 58px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(12, 108, 98);
    white-space: normal;
    margin: 8px 0 0 0;
}

.yard-page {
    display: none;
}

.yard-page.shown {
    display: flex;
}

.section-label {
    font-size: 17px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    color: rgb(160, 50, 24);
    margin: 0 0 6px 0;
}

/* Items in a list: no boxes, a rule between them. */
.card {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-color: rgba(22, 36, 64, 0.2);
    border-radius: 0;
    margin: 0;
    padding: 12px 0 12px 18px;
}

/* A job: the chosen one has a rust bar on its left. */
.job-card {
    border-left-width: 5px;
    border-left-color: rgba(0, 0, 0, 0);
    transition-duration: 0.15s;
}

.job-card:hover {
    background-color: rgba(22, 36, 64, 0.06);
}

.job-card.active-job {
    border-left-color: rgb(160, 50, 24);
    background-color: rgba(160, 50, 24, 0.08);
}

.job-card:disabled {
    opacity: 0.7;
}

/* A button centres its content by default: the words line up on the left instead. */
.card-main {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: flex-start;
}

.card-main > Label {
    -unity-text-align: middle-left;
}

.card-title {
    font-size: 26px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(22, 36, 64);
    margin: 0;
}

.job-card.active-job .card-title {
    color: rgb(160, 50, 24);
}

.card-desc {
    font-size: 18px;
    color: rgb(62, 74, 100);
    white-space: normal;
    margin: 2px 0 0 0;
}

.card-pay {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(12, 108, 98);
    margin: 0 4px 0 12px;
}

/* Buy: a rust word with a line under it. */
.buy-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 3px;
    border-color: rgb(160, 50, 24);
    border-radius: 0;
    font-size: 20px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgb(160, 50, 24);
    padding: 4px 4px;
    margin: 0 4px 0 12px;
}

.buy-btn:hover {
    color: rgb(22, 36, 64);
    border-color: rgb(22, 36, 64);
}

.buy-btn:disabled {
    color: rgb(62, 74, 100);
    border-color: rgba(0, 0, 0, 0);
    opacity: 1;
}

/* The link between the job list and the upgrades. */
.yard-link {
    align-self: flex-start;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    font-size: 18px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(22, 36, 64);
    padding: 4px 0;
    margin: 14px 0 0 0;
}

.yard-link:hover {
    color: rgb(160, 50, 24);
}

.spacer {
    flex-grow: 1;
}

/* Buttons that move on to the next screen on the report (Continue): a peach word. */
.start-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    align-items: center;
    padding: 8px 10px;
    margin: 0;
    color: rgb(255, 205, 175);
    font-size: 20px;
    letter-spacing: 8px;
}

.start-btn:hover {
    background-color: rgba(0, 0, 0, 0);
    scale: 1.03 1.03;
}

.start-btn:active {
    scale: 0.98 0.98;
}

.start-btn:disabled {
    background-color: rgba(0, 0, 0, 0);
    opacity: 1;
}

/* SET SAIL: the lever (drawn by ShipyardManager) beside a big rust word; it throws when pressed. */
.sail-lever {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-top-width: 1px;
    border-color: rgba(22, 36, 64, 0.3);
    border-radius: 0;
    padding: 12px 4px 4px 0;
    margin: 0;
    transition-duration: 0.15s;
}

.sail-lever:hover {
    background-color: rgba(0, 0, 0, 0);
}

.sail-lever:active {
    scale: 0.98 0.98;
}

.sail-lever:disabled {
    opacity: 0.5;
}

.lever-slot {
    width: 64px;
    height: 72px;
    margin-right: 16px;
    flex-shrink: 0;
}

.start-title {
    font-size: 40px;
    letter-spacing: 12px;
    -unity-font-style: bold;
    color: rgb(160, 50, 24);
    padding-bottom: 4px;
    border-bottom-width: 4px;
    border-color: rgb(160, 50, 24);
    margin: 0;
}

.sail-lever:hover .start-title {
    color: rgb(22, 36, 64);
    border-color: rgb(22, 36, 64);
}

.loading-caption {
    position: absolute;
    bottom: 64px;
    align-self: center;
    font-size: 20px;
    color: rgb(255, 255, 255);
    letter-spacing: 8px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    display: none;
}

/* ------------------------------------------------------------ voyage report: a page of the ship's log */

.results-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 10, 16, 0.6);
    align-items: center;
    justify-content: center;
    display: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
}

.results-backdrop.shown {
    opacity: 1;
}

.results-panel {
    width: 700px;
    padding: 24px 36px 26px 36px;
    background-color: rgb(232, 218, 184);
    border-width: 3px;
    border-color: rgb(140, 110, 56);
    border-radius: 6px;
    border-left-width: 14px;
    border-left-color: rgb(92, 52, 30);
}

.log-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 6px;
    border-bottom-width: 2px;
    border-color: rgb(120, 86, 46);
}

.log-eyebrow {
    font-size: 14px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(120, 82, 34);
    margin: 0;
}

.log-voyage {
    font-size: 14px;
    -unity-font-style: italic;
    color: rgb(120, 82, 34);
    margin: 0;
}

/* A rubber stamp across the top corner: green on delivery, red when the ship was lost. */
.log-stamp {
    position: absolute;
    right: 28px;
    top: 50px;
    rotate: -10deg;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgba(40, 120, 70, 0.85);
    border-width: 4px;
    border-color: rgba(40, 120, 70, 0.85);
    border-radius: 6px;
    padding: 4px 14px;
}

.results-panel.failed .log-stamp {
    color: rgba(170, 40, 30, 0.85);
    border-color: rgba(170, 40, 30, 0.85);
}

.results-title {
    font-size: 34px;
    color: rgb(64, 43, 23);
    -unity-font-style: bold;
    margin-top: 10px;
}

.results-panel.failed .results-title {
    color: rgb(150, 40, 28);
}

.results-subtitle {
    font-size: 18px;
    color: rgb(92, 66, 38);
    margin-bottom: 10px;
    white-space: normal;
    -unity-font-style: italic;
}

/* Ruled lines, like the log's printed rows. */
.results-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 7px 0;
    border-bottom-width: 1px;
    border-color: rgba(120, 86, 46, 0.35);
}

.results-row-label {
    font-size: 19px;
    color: rgb(92, 66, 38);
}

.results-row-value {
    font-size: 19px;
    color: rgb(48, 32, 16);
    -unity-font-style: bold;
}

.results-row-value.good {
    color: rgb(30, 110, 60);
}

.results-row-value.bad {
    color: rgb(165, 40, 28);
}

.results-total {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
    padding-top: 8px;
    border-top-width: 2px;
    border-color: rgb(120, 86, 46);
}

.results-total-label {
    font-size: 18px;
    color: rgb(120, 82, 34);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.results-total-value {
    font-size: 32px;
    color: rgb(64, 43, 23);
    -unity-font-style: bold;
}

/* The tip: a note pinned to the page. */
.results-tip {
    font-size: 17px;
    color: rgb(48, 40, 20);
    white-space: normal;
    margin: 14px 0 16px 0;
    padding: 10px 14px;
    background-color: rgb(250, 238, 170);
    border-left-width: 4px;
    border-color: rgb(205, 160, 72);
    border-radius: 4px;
}

.results-continue {
    font-size: 22px;
}
