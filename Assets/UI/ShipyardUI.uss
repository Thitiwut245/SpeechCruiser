/* The shipyard and the voyage report, in the game's Alto-style look (UiTheme).
   The store is on paper (UiTheme.Paper): navy ink on a sand gradient from the left edge,
   projector-safe, bold words, nothing under 16px. One page, few choices: the job (or the
   story mission and its phrases), then SET SAIL. Upgrades are one link away.
   The report stays white on a dusk dim, like the rest of the game at sea.
   Sizes are 1080p pixels (the panel scales). */

.shipyard-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.store-panel {
    position: absolute;
    left: 100px;
    top: 56px;
    bottom: 44px;
    width: 600px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

/* Nothing in the store squashes when content grows; the spacer above SET SAIL absorbs it. */
.store-panel > * {
    flex-shrink: 0;
}

.store-panel > .spacer {
    flex-shrink: 1;
}

/* The heading and the money: one line. */
.store-head {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-color: rgba(22, 36, 64, 0.3);
}

.store-title {
    flex-shrink: 1;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(22, 36, 64);
    white-space: normal;
    margin: 0;
}

.credits-value {
    flex-shrink: 0;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(12, 108, 98);
    margin: 0 0 0 20px;
}

/* What the radio heard, and other news: room is kept for it, so nothing jumps. */
.toast {
    min-height: 58px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(12, 108, 98);
    white-space: normal;
    margin: 8px 0 0 0;
}

.yard-page {
    display: none;
}

.yard-page.shown {
    display: flex;
}

.section-label {
    font-size: 17px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    color: rgb(160, 50, 24);
    margin: 0 0 6px 0;
}

/* Items in a list: no boxes, a rule between them. */
.card {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-color: rgba(22, 36, 64, 0.2);
    border-radius: 0;
    margin: 0;
    padding: 12px 0 12px 18px;
}

/* A job: the chosen one has a rust bar on its left. */
.job-card {
    border-left-width: 5px;
    border-left-color: rgba(0, 0, 0, 0);
    transition-duration: 0.15s;
}

.job-card:hover {
    background-color: rgba(22, 36, 64, 0.06);
}

.job-card.active-job {
    border-left-color: rgb(160, 50, 24);
    background-color: rgba(160, 50, 24, 0.08);
}

.job-card:disabled {
    opacity: 0.7;
}

/* A button centres its content by default: the words line up on the left instead. */
.card-main {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: flex-start;
}

.card-main > Label {
    -unity-text-align: middle-left;
}

.card-title {
    font-size: 26px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(22, 36, 64);
    margin: 0;
}

.job-card.active-job .card-title {
    color: rgb(160, 50, 24);
}

.card-desc {
    font-size: 18px;
    color: rgb(62, 74, 100);
    white-space: normal;
    margin: 2px 0 0 0;
}

.card-pay {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(12, 108, 98);
    margin: 0 4px 0 12px;
}

/* Buy: a rust word with a line under it. */
.buy-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 3px;
    border-color: rgb(160, 50, 24);
    border-radius: 0;
    font-size: 20px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgb(160, 50, 24);
    padding: 4px 4px;
    margin: 0 4px 0 12px;
}

.buy-btn:hover {
    color: rgb(22, 36, 64);
    border-color: rgb(22, 36, 64);
}

.buy-btn:disabled {
    color: rgb(62, 74, 100);
    border-color: rgba(0, 0, 0, 0);
    opacity: 1;
}

/* The link between the job list and the upgrades. */
.yard-link {
    align-self: flex-start;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    font-size: 18px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(22, 36, 64);
    padding: 4px 0;
    margin: 14px 0 0 0;
}

.yard-link:hover {
    color: rgb(160, 50, 24);
}

.spacer {
    flex-grow: 1;
}

/* Buttons that move on to the next screen on the report (Continue): a peach word. */
.start-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    align-items: center;
    padding: 8px 10px;
    margin: 0;
    color: rgb(255, 205, 175);
    font-size: 20px;
    letter-spacing: 8px;
}

.start-btn:hover {
    background-color: rgba(0, 0, 0, 0);
    scale: 1.03 1.03;
}

.start-btn:active {
    scale: 0.98 0.98;
}

.start-btn:disabled {
    background-color: rgba(0, 0, 0, 0);
    opacity: 1;
}

/* SET SAIL: the lever (drawn by ShipyardManager) beside a big rust word; it throws when pressed. */
.sail-lever {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-top-width: 1px;
    border-color: rgba(22, 36, 64, 0.3);
    border-radius: 0;
    padding: 12px 4px 4px 0;
    margin: 0;
    transition-duration: 0.15s;
}

.sail-lever:hover {
    background-color: rgba(0, 0, 0, 0);
}

.sail-lever:active {
    scale: 0.98 0.98;
}

.sail-lever:disabled {
    opacity: 0.5;
}

.lever-slot {
    width: 64px;
    height: 72px;
    margin-right: 16px;
    flex-shrink: 0;
}

.start-title {
    font-size: 40px;
    letter-spacing: 12px;
    -unity-font-style: bold;
    color: rgb(160, 50, 24);
    padding-bottom: 4px;
    border-bottom-width: 4px;
    border-color: rgb(160, 50, 24);
    margin: 0;
}

.sail-lever:hover .start-title {
    color: rgb(22, 36, 64);
    border-color: rgb(22, 36, 64);
}

.loading-caption {
    position: absolute;
    bottom: 64px;
    align-self: center;
    font-size: 20px;
    color: rgb(255, 255, 255);
    letter-spacing: 8px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    display: none;
}

/* ------------------------------------------------------------ voyage report */

/* On paper like the shipyard (UiTheme.Paper): a full sand page, navy ink, so it reads on a
   projector over even the brightest sea. Few rows: what arrived, the hits, the time, the money. */
.results-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(250, 242, 228, 0.96);
    align-items: center;
    justify-content: center;
    display: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.results-backdrop.shown {
    opacity: 1;
}

.results-panel {
    width: 760px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

.log-header {
    display: none;
}

/* The outcome by the title: a teal word when delivered, red when lost, a line under it. */
.log-stamp {
    position: absolute;
    right: 0;
    top: 22px;
    font-size: 20px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    color: rgb(12, 108, 98);
    padding-bottom: 3px;
    border-bottom-width: 3px;
    border-color: rgb(12, 108, 98);
}

.results-panel.failed .log-stamp {
    color: rgb(170, 30, 40);
    border-color: rgb(170, 30, 40);
}

.results-title {
    font-size: 46px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(22, 36, 64);
    margin: 0;
}

.results-panel.failed .results-title {
    color: rgb(170, 30, 40);
}

.results-subtitle {
    font-size: 21px;
    color: rgb(62, 74, 100);
    margin: 4px 0 18px 0;
    white-space: normal;
}

.results-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom-width: 1px;
    border-color: rgba(22, 36, 64, 0.25);
}

.results-row-label {
    font-size: 22px;
    color: rgb(62, 74, 100);
}

.results-row-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(22, 36, 64);
}

/* The radio English part of the report: a small heading, then tighter rows. */
.results-heading {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(12, 108, 98);
    margin: 18px 0 2px 0;
}

.results-row.compact {
    padding: 7px 0;
}

.results-row.compact .results-row-label,
.results-row.compact .results-row-value {
    font-size: 20px;
}

.results-row-value.good {
    color: rgb(12, 108, 98);
}

.results-row-value.bad {
    color: rgb(170, 30, 40);
}

.results-total {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 16px;
}

.results-total-label {
    font-size: 18px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    color: rgb(62, 74, 100);
}

.results-total-value {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(22, 36, 64);
}

.results-total-value.bad {
    color: rgb(170, 30, 40);
}

.results-tip {
    font-size: 20px;
    color: rgb(22, 36, 64);
    white-space: normal;
    margin: 20px 0 24px 0;
    padding: 4px 0 4px 16px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 4px;
    border-color: rgb(160, 50, 24);
    border-radius: 0;
}

.results-continue {
    align-self: center;
    font-size: 24px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    color: rgb(160, 50, 24);
    border-bottom-width: 3px;
    border-color: rgb(160, 50, 24);
}

.results-continue:hover {
    color: rgb(22, 36, 64);
    border-color: rgb(22, 36, 64);
}
