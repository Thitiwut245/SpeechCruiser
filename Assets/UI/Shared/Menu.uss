/* Menus shared by the title screen and the pause screen (pause, settings), in the bridge
   style of the HUD: dark glass, brass rims, amber headings. The title screen's own board
   is in Title.uss. */

.main-container {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 1);
    align-items: center;
    justify-content: center;
}

/* The title screen: the harbour shows through. */
.title-screen {
    background-color: rgba(0, 0, 0, 0);
}

.game-title {
    font-size: 72px;
    color: rgb(242, 247, 250);
    -unity-font-style: bold;
    letter-spacing: 6px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.game-title--accent {
    color: rgb(255, 199, 69);
    margin-top: -18px;
}

.game-tagline {
    font-size: 21px;
    color: rgb(196, 209, 221);
    white-space: normal;
    margin: 6px 0 36px 0;
}

.radio-status {
    font-size: 16px;
    color: rgb(196, 209, 221);
    white-space: normal;
}

/* ---- Cards: a brass-rimmed glass board. */

.menu-panel {
    align-items: stretch;
    justify-content: center;
    width: 300px;
}

.menu-title {
    font-size: 34px;
    color: rgb(255, 199, 69);
    -unity-text-align: middle-center;
    letter-spacing: 6px;
    margin-bottom: 24px;
    -unity-font-style: bold;
}

.menu-emblem {
    align-self: center;
    margin-bottom: 6px;
}

/* Settings over the live harbour, and every card on the pause screen. */
.title-screen .settings-panel,
.pause-container .menu-panel {
    padding: 28px 36px;
    background-color: rgba(6, 14, 22, 0.97);
    border-width: 2px;
    border-color: rgb(140, 110, 56);
    border-radius: 14px;
}

.pause-container {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 10, 16, 0.86);
    align-items: center;
    justify-content: center;
}

.pause-container .menu-panel {
    width: 400px;
}

/* ---- Buttons: glass plates with a brass rim; brass when pressed. */

.menu-button {
    font-size: 23px;
    color: rgb(242, 247, 250);
    background-color: rgba(18, 34, 48, 0.95);
    border-width: 2px;
    border-color: rgba(140, 110, 56, 0.75);
    border-radius: 10px;
    padding: 13px 15px;
    margin-top: 6px;
    margin-bottom: 6px;
    transition-duration: 0.15s;
}

.menu-button:hover {
    background-color: rgb(30, 54, 74);
    border-color: rgb(205, 165, 90);
    scale: 1.02 1.02;
}

.menu-button:active {
    background-color: rgb(205, 160, 72);
    border-color: rgb(255, 214, 120);
    color: rgb(28, 20, 6);
    scale: 0.98 0.98;
}

/* The first button on a card (Resume) is the brass one. */
.menu-button--primary,
.pause-container #ResumeButton {
    background-color: rgb(205, 160, 72);
    border-color: rgb(255, 214, 120);
    color: rgb(28, 20, 6);
    -unity-font-style: bold;
}

.menu-button--primary:hover,
.pause-container #ResumeButton:hover {
    background-color: rgb(228, 184, 92);
}

/* ---- Settings page: two columns (sound | controls). Declared after the pause card rule
   so the wider size wins inside the pause menu too. */

.settings-panel,
.pause-container .settings-panel {
    width: 920px;
}

.settings-columns {
    flex-direction: row;
    align-items: flex-start;
}

.settings-column {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 12px;
    padding: 12px 16px;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(140, 110, 56, 0.45);
    border-radius: 10px;
}

.settings-heading {
    font-size: 15px;
    color: rgb(205, 165, 90);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-color: rgba(140, 110, 56, 0.45);
}

.settings-row {
    flex-direction: column;
    margin-bottom: 12px;
}

.settings-label {
    color: rgb(242, 247, 250);
    font-size: 18px;
    margin-bottom: 5px;
    -unity-font-style: bold;
}

.settings-note {
    font-size: 15px;
    color: rgb(196, 209, 221);
    white-space: normal;
    margin-bottom: 12px;
}

.settings-dropdown {
    color: rgb(255, 255, 255);
    font-size: 18px;
}

/* The theme paints the dropdown's inner box light grey; make it dark glass so white text reads. */
.settings-dropdown .unity-base-popup-field__input {
    background-color: rgb(18, 34, 48);
    border-color: rgba(140, 110, 56, 0.75);
    border-radius: 6px;
    padding: 6px 10px;
}

.settings-dropdown .unity-base-popup-field__text {
    color: rgb(242, 247, 250);
}

.settings-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(205, 165, 90);
}

.settings-slider {
    margin-top: 5px;
}

/* Brass slider: the track and the knob. */
.settings-slider .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(140, 110, 56, 0.6);
}

.settings-slider .unity-base-slider__dragger {
    background-color: rgb(205, 160, 72);
    border-color: rgb(255, 214, 120);
}

/* The key boxes: brass plates; white while waiting for a key. */
.bind-button {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(28, 20, 6);
    background-color: rgb(205, 160, 72);
    border-width: 2px;
    border-color: rgb(255, 214, 120);
    border-radius: 6px;
    padding: 8px 12px;
    margin: 4px 0 0 0;
    width: 160px;
}

.bind-button:hover {
    background-color: rgb(228, 184, 92);
}

.bind-button.listening {
    background-color: rgb(242, 247, 250);
}

.settings-toggle {
    color: rgb(242, 247, 250);
    font-size: 17px;
    margin-left: 0;
}

.settings-toggle > .unity-label {
    color: rgb(242, 247, 250);
    white-space: normal;
    min-width: 0;
    flex-shrink: 1;
}

.settings-small-button {
    font-size: 18px;
    padding: 8px;
    margin-top: 4px;
}

.settings-back {
    margin-top: 16px;
    align-self: center;
    width: 300px;
}
