<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <ui:Template name="SettingsPanel" src="Shared/SettingsPanel.uxml" />
    <ui:Style src="Shared/Menu.uss" />

    <!-- The live harbour (MenuBackdrop) shows through; the title sits on a panel to the left. -->
    <ui:VisualElement class="main-container title-screen" name="MainMenuContainer">
        <ui:VisualElement class="menu-panel title-panel" name="MainPanel">
            <ui:Label text="SPEECH" class="game-title" />
            <ui:Label text="CRUISER" class="game-title game-title--accent" />
            <ui:Label text="Captain a cargo ship with your voice." class="game-tagline" />
            <ui:Label name="CareerLabel" text="" class="career-line" />

            <ui:Button name="PlayButton" text="Set Sail" class="menu-button menu-button--primary" />
            <ui:Button name="SettingButton" text="Settings" class="menu-button" />
            <ui:Button name="NewCareerButton" text="New Career" class="menu-button menu-button--quiet" />
            <ui:Button name="QuitButton" text="Quit" class="menu-button" />
            <ui:Label name="RadioStatusLabel" text="" class="radio-status" />
        </ui:VisualElement>

        <ui:Instance template="SettingsPanel" />
    </ui:VisualElement>
</ui:UXML>
