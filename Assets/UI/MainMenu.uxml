<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <ui:Template name="SettingsPanel" src="Shared/SettingsPanel.uxml" />
    <ui:Style src="Shared/Menu.uss" />
    <ui:Style src="Shared/Title.uss" />

    <!-- The live harbour (MenuBackdrop) shows through; the title stands on a sand gradient to the left. -->
    <ui:VisualElement class="main-container title-screen" name="MainMenuContainer">
        <ui:VisualElement class="title-panel" name="MainPanel">
            <ui:VisualElement name="Emblem" class="title-emblem" />
            <ui:Label text="SPEECH" class="game-title" />
            <ui:Label text="CRUISER" class="game-title game-title--accent" />
            <ui:Label text="Sail a cargo ship with your voice." class="game-tagline" />

            <ui:Button name="StoryButton" class="title-button title-button--primary">
                <ui:Label name="StoryButtonTitle" text="STORY" class="title-button__title" />
                <ui:Label name="StoryButtonSub" text="" class="title-button__sub" />
            </ui:Button>
            <ui:Button name="PlayButton" class="title-button">
                <ui:Label name="PlayButtonTitle" text="FREE SAIL" class="title-button__title" />
                <ui:Label name="CareerLabel" text="" class="title-button__sub" />
            </ui:Button>

            <ui:VisualElement class="title-row">
                <ui:Button name="SettingButton" text="SETTINGS" class="title-small" />
                <ui:Button name="QuitButton" text="QUIT" class="title-small" />
            </ui:VisualElement>
            <ui:Button name="NewCareerButton" text="NEW CAREER" class="title-quiet" />

            <ui:VisualElement class="radio-plate">
                <ui:VisualElement name="RadioDot" class="radio-plate__dot" />
                <ui:Label name="RadioStatusLabel" text="" class="radio-status" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Instance template="SettingsPanel" />
    </ui:VisualElement>
</ui:UXML>
